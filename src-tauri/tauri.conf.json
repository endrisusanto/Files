{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FireFiles",
  "version": "0.1.184",
  "identifier": "local.android-file-bridge",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "FireFiles",
        "width": 1200,
        "height": 800,
        "visible": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDNDMjY4NjhCRDNGMzE4QgpSV1NMTVQrOWFHakNBeFVtSVphYWlJckNwT0dCYlB3bXRmSEJNRHRrc2hTTkpFWEFFZEZOcEJPawo=",
      "endpoints": [
        "https://github.com/endrisusanto/Files/releases/latest/download/latest.json"
      ]
    }
  }
}
